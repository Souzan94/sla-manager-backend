# Example .env (do NOT commit real secrets to source control)
NODE_ENV=development
PORT=3000

DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=<your-db-password>
DB_DATABASE=SLA_DB

TYPEORM_SYNCHRONIZE=true

# Optional placeholders
# JWT_SECRET=change-me
# REDIS_URL=redis://localhost:6379
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
